# Example environment variables — copy to .env.local and fill in your values (do NOT commit secrets)

# ── Base de datos (Neon / Supabase / Railway / Vercel Postgres) ───────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=verify-full
# Direct URL sin pooler — necesario para prisma db push en Neon
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=verify-full

# ── Clerk ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Auth M2M ─────────────────────────────────────────────────────────────────
# Clave que valida requests entrantes de Driver App y Feedback App
INTERNAL_API_KEY=

# Tokens para llamar a otras apps
DRIVER_APP_TOKEN=
PAYMENTS_APP_TOKEN=
FEEDBACK_APP_TOKEN=

# ── URLs de otras apps ────────────────────────────────────────────────────────
DRIVER_APP_URL=https://tu-driver-app.vercel.app
PAYMENTS_APP_URL=https://tu-payments-app.vercel.app
FEEDBACK_APP_URL=https://tu-feedback-app.vercel.app

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000


